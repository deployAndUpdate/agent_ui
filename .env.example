# Visual Agent Engine — copy to .env and adjust
# cp .env.example .env

# Runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Store: leave empty for in-memory; set for Postgres
# DATABASE_URL=postgres://visual:visual@127.0.0.1:5432/visual_engine

# Auth: in production (NODE_ENV=production) API_KEYS is required unless AUTH_ENABLED=false
# AUTH_ENABLED=true
# API_KEYS=dev-key,another-key

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Outbox
OUTBOX_INTERVAL_MS=50
OUTBOX_MAX_ATTEMPTS=5

# CORS (* or origin URL). Prefer explicit origin in production.
CORS_ORIGIN=*

# CLI / TUI
VISUAL_ENGINE_API=http://127.0.0.1:3001
# VISUAL_ENGINE_API_KEY=dev-key
TUI_SESSION_ID=demo
# TUI_WS_URL=ws://127.0.0.1:3001/api/v1/tui/stream?sessionId=demo
