# Visual Agent Engine — copy to .env and adjust
# cp .env.example .env

# Runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Store: leave empty for in-memory; set for Postgres
# DATABASE_URL=postgres://visual:visual@127.0.0.1:5432/visual_engine

# Auth: in production (NODE_ENV=production) API_KEYS is required unless AUTH_ENABLED=false
# AUTH_ENABLED=true
# API_KEYS=dev-key,another-key

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Outbox
OUTBOX_INTERVAL_MS=50
OUTBOX_MAX_ATTEMPTS=5

# CORS (* or origin URL). Prefer explicit origin in production.
CORS_ORIGIN=*

# CLI / TUI
VISUAL_ENGINE_API=http://127.0.0.1:3001
# VISUAL_ENGINE_API_KEY=dev-key
TUI_SESSION_ID=demo
# TUI_WS_URL=ws://127.0.0.1:3001/api/v1/tui/stream?sessionId=demo

# Agent webhook for detail `/details` command (POST JSON with systemPrompt "more details")
TUI_AGENT_WEBHOOK_URL=http://127.0.0.1:9090/agent
# TUI_AGENT_WEBHOOK_TOKEN=
# TUI_ACTION_REACTOR=builtin

# Local bridge (npm run bridge) — universal /details adapter (any agent)
TUI_BRIDGE_DRIVER=exec
TUI_BRIDGE_COMMAND="node packages/tui-agent-bridge/examples/enrich-echo.mjs"
# TUI_BRIDGE_COMMAND="bash packages/tui-agent-bridge/examples/enrich-claude.sh"
# TUI_BRIDGE_COMMAND="bash packages/tui-agent-bridge/examples/enrich-opencode.sh"
# TUI_BRIDGE_COMMAND="bash packages/tui-agent-bridge/examples/enrich-cursor.sh"
# TUI_BRIDGE_FORWARD_URL=http://127.0.0.1:9100/enrich
# TUI_BRIDGE_FORWARD_MODE=sync    # sync | async
# TUI_BRIDGE_PORT=9090
# CURSOR_API_KEY=cursor_...       # only if using enrich-cursor / driver=cli|sdk
