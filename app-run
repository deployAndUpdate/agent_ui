#!/usr/bin/env bash
# Visual Engine — single entrypoint for local runs.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

usage() {
  cat <<'EOF'
Usage:
  ./app-run front     # backend + web UI (Vite)
  ./app-run stop      # stop everything started by app-run
  ./app-run status    # show what's running

Options (after mode):
  --session <id>      default: demo
  --api <url>         default: http://127.0.0.1:3001
  --api-key <key>
  --no-wait           don't wait for backend health

Examples:
  ./app-run front --session demo
EOF
}

MODE="${1:-}"
if [[ -z "$MODE" || "$MODE" == "-h" || "$MODE" == "--help" ]]; then
  usage
  exit 0
fi
shift || true

SESSION="${SESSION_ID:-demo}"
API="${VISUAL_ENGINE_API:-http://127.0.0.1:3001}"
API_KEY="${VISUAL_ENGINE_API_KEY:-}"
WAIT_HEALTH=1
EXTRA=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --session) SESSION="$2"; shift 2 ;;
    --api) API="$2"; shift 2 ;;
    --api-key) API_KEY="$2"; shift 2 ;;
    --no-wait) WAIT_HEALTH=0; shift ;;
    *) EXTRA+=("$1"); shift ;;
  esac
done

RUN_DIR="$ROOT/.app-run"
mkdir -p "$RUN_DIR"
PID_BACKEND="$RUN_DIR/backend.pid"
PID_FRONT="$RUN_DIR/frontend.pid"
LOG_BACKEND="$RUN_DIR/backend.log"
LOG_FRONT="$RUN_DIR/frontend.log"

is_alive() {
  local pid_file="$1"
  [[ -f "$pid_file" ]] || return 1
  local pid
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null
}

kill_pidfile() {
  local pid_file="$1"
  local name="$2"
  if ! [[ -f "$pid_file" ]]; then
    return 0
  fi
  local pid
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
    kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 20); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    kill -9 -- "-$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null || true
    echo "stopped $name (pid $pid)"
  fi
  rm -f "$pid_file"
}

port_open() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -ltn "sport = :$port" 2>/dev/null | grep -q ":$port"
  else
    (echo >/dev/tcp/127.0.0.1/"$port") >/dev/null 2>&1
  fi
}

wait_backend() {
  local url="$API/health"
  echo -n "waiting for backend at $API …"
  for _ in $(seq 1 60); do
    if curl -sf "$url" >/dev/null 2>&1; then
      echo " ok"
      return 0
    fi
    echo -n "."
    sleep 0.25
  done
  echo
  echo "backend did not become healthy in time; see $LOG_BACKEND" >&2
  return 1
}

start_backend() {
  if is_alive "$PID_BACKEND"; then
    echo "backend already running (pid $(cat "$PID_BACKEND"))"
    return 0
  fi
  if port_open 3001 && [[ "$WAIT_HEALTH" == "1" ]]; then
    if curl -sf "$API/health" >/dev/null 2>&1; then
      echo "backend already listening on :3001 (external)"
      return 0
    fi
  fi
  echo "starting backend → $LOG_BACKEND"
  setsid npm run dev:backend >"$LOG_BACKEND" 2>&1 < /dev/null &
  echo $! >"$PID_BACKEND"
  if [[ "$WAIT_HEALTH" == "1" ]]; then
    wait_backend
  fi
}

start_frontend() {
  if is_alive "$PID_FRONT"; then
    echo "frontend already running (pid $(cat "$PID_FRONT"))"
    return 0
  fi
  echo "starting frontend → $LOG_FRONT"
  setsid npm run dev:frontend -- --host 0.0.0.0 --port 5173 >"$LOG_FRONT" 2>&1 < /dev/null &
  echo $! >"$PID_FRONT"
  echo -n "waiting for frontend :5173 …"
  for _ in $(seq 1 60); do
    if port_open 5173; then
      echo " ok"
      echo "UI: http://localhost:5173/?sessionId=$SESSION"
      return 0
    fi
    echo -n "."
    sleep 0.25
  done
  echo
  echo "frontend did not start; see $LOG_FRONT" >&2
  return 1
}

cmd_stop() {
  kill_pidfile "$PID_FRONT" "frontend"
  kill_pidfile "$PID_BACKEND" "backend"
  echo "done"
}

cmd_status() {
  for pair in "backend:$PID_BACKEND" "frontend:$PID_FRONT"; do
    local name="${pair%%:*}"
    local file="${pair##*:}"
    if is_alive "$file"; then
      echo "$name: running pid=$(cat "$file")"
    else
      echo "$name: stopped"
    fi
  done
  if curl -sf "$API/health" >/dev/null 2>&1; then
    echo "api: $API healthy"
  else
    echo "api: $API not reachable"
  fi
}

cleanup_on_signal() {
  echo
  echo "shutting down…"
  cmd_stop
  exit 0
}

run_and_wait() {
  trap cleanup_on_signal INT TERM

  start_backend
  start_frontend

  echo
  echo "mode=$MODE  session=$SESSION"
  echo "logs: $RUN_DIR/"
  echo "stop: ./app-run stop   (or Ctrl+C)"
  echo

  while true; do
    local alive=0
    if is_alive "$PID_BACKEND"; then alive=1; fi
    if is_alive "$PID_FRONT"; then alive=1; fi
    if [[ "$alive" == "0" ]] && curl -sf "$API/health" >/dev/null 2>&1; then
      if is_alive "$PID_FRONT"; then alive=1; fi
    fi
    if [[ "$alive" == "0" ]]; then
      echo "all managed processes exited"
      break
    fi
    sleep 1
  done
}

case "$MODE" in
  front|frontend|web|f)
    run_and_wait
    ;;
  stop)
    cmd_stop
    ;;
  status|st)
    cmd_status
    ;;
  *)
    echo "Unknown mode: $MODE" >&2
    echo "Use: front | stop | status" >&2
    exit 1
    ;;
esac
