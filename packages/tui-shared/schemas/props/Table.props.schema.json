{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TableProps",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "headers": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "title": { "type": "string" },
    "align": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["left", "right", "center"]
      }
    },
    "numericAlign": { "type": "boolean", "default": true },
    "zebra": { "type": "boolean", "default": true },
    "compact": { "type": "boolean" },
    "highlightColumn": { "type": "integer", "minimum": 0 }
  },
  "required": ["headers", "rows"]
}
