{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChartProps",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["line", "bar", "sparkline", "pie", "stacked"],
      "default": "line"
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "data": {
            "type": "array",
            "items": { "type": "number" }
          }
        },
        "required": ["name", "data"]
      }
    }
  },
  "required": ["datasets"]
}
