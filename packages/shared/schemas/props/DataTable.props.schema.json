{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DataTableProps",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "columns": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "rows": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "required": ["columns", "rows"]
}
