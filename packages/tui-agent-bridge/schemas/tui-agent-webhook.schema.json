{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visual-engine.local/schemas/tui-agent-webhook.json",
  "title": "TUI Agent Webhook (/details)",
  "description": "Universal contract: Visual Engine POSTs this to TUI_AGENT_WEBHOOK_URL. Any agent (Cursor, Claude Code, OpenCode, custom) must eventually POST a TuiManifest with taskId detail_* to callback.manifestUrl.",
  "type": "object",
  "required": [
    "systemPrompt",
    "command",
    "sessionId",
    "taskId",
    "widgetId",
    "payload",
    "callback"
  ],
  "properties": {
    "systemPrompt": { "type": "string" },
    "command": { "type": "string", "const": "/details" },
    "sessionId": { "type": "string" },
    "taskId": { "type": "string", "description": "Usually detail_<widgetId>_<rowIndex>" },
    "widgetId": { "type": "string" },
    "payload": {
      "type": "object",
      "properties": {
        "command": { "type": "string" },
        "systemPrompt": { "type": "string" },
        "rowIndex": { "type": ["integer", "null"] },
        "row": { "type": "array", "items": { "type": "string" } },
        "sourceWidgetId": { "type": "string" },
        "detailTaskId": { "type": "string" }
      },
      "additionalProperties": true
    },
    "currentManifest": {},
    "callback": {
      "type": "object",
      "required": ["manifestUrl", "sessionId"],
      "properties": {
        "manifestUrl": {
          "type": "string",
          "format": "uri",
          "description": "POST { sessionId, manifest } here. detail_* is ephemeral."
        },
        "sessionId": { "type": "string" }
      }
    }
  }
}
