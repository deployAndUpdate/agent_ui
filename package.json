{
  "name": "visual-engine",
  "version": "0.2.0",
  "private": true,
  "description": "Server-Driven TUI: agent JSON → AJV → outbox → Ratatui",
  "workspaces": [
    "packages/*",
    "backend"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "test:tui-shared": "npm test -w @visual-engine/tui-shared",
    "test:backend": "npm test -w backend",
    "test:cli": "npm test -w @visual-engine/cli",
    "test:tui": "cargo test --manifest-path tui/Cargo.toml",
    "dev:backend": "npm run dev -w backend",
    "start:backend": "npm run start -w backend",
    "dev:tui": "cargo run --release --manifest-path tui/Cargo.toml",
    "dev:tui-stub": "cargo run --release --manifest-path tui/Cargo.toml",
    "build:tui": "cargo build --release --manifest-path tui/Cargo.toml",
    "app:tui": "bash ./vae --no-tui",
    "app:stop": "bash ./vae stop",
    "start": "bash ./vae",
    "smoke": "bash ./vae smoke",
    "agent": "npm run start -w @visual-engine/cli --",
    "bridge": "npm run start -w @visual-engine/tui-agent-bridge",
    "build": "npm run build --workspaces --if-present && npm run build:tui"
  },
  "engines": {
    "node": ">=20"
  }
}
